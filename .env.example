# API Configuration
VITE_API_URL=http://localhost:5002/v1

# Identity service (accounts.reckonio.com). When set, LOGIN goes here instead
# of Reckon Bill's API; the response carries a Bill-scoped token that is used
# for all subsequent API calls. Leave unset to keep the original login path.
#
# Registration, email verification, password reset, Google and Apple still go
# to VITE_API_URL — they have not been ported to accounts yet.
#
# VITE_AUTH_URL=https://identity.reckonio.com/v1/accounts
